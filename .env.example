# =====================================================================
# QUANT AI — CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Nivel: Profesional | Moneda: COP | Zona Horaria: America/Bogota
# =====================================================================

# -----------------
# FRONTEND CONFIG
# -----------------
NEXT_PUBLIC_APP_NAME=QUANT_AI
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_CURRENCY=COP
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Bogota

# -----------------
# SUPABASE CONFIG (PostgreSQL & Auth)
# -----------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_DB_PASSWORD=

# -----------------
# BACKEND QUANT API
# -----------------
QUANT_API_HOST=0.0.0.0
QUANT_API_PORT=8000
QUANT_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# -----------------
# MARKET DATA PROVIDERS (Public / Free by default)
# -----------------
# Yahoo Finance: Sin API key requerida para datos básicos OHLCV
YAHOO_FINANCE_ENABLED=true
YAHOO_CACHE_TTL_SECONDS=60

# Binance Public Market Data API & WebSocket
BINANCE_MARKET_DATA_URL=https://data-api.binance.vision
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/ws

# Bolsa de Valores de Colombia (Importador CSV & Local Cache)
BVC_DATA_PATH=./data/bvc/

# Fuentes Macroeconómicas Oficiales (BanRep, DANE, FRED)
MACRO_DATA_PATH=./data/macro/
FRED_API_KEY=

# -----------------
# AI ENGINE CONFIGURATION (Opcional / Desacoplado)
# -----------------
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-pro

AI_VISION_PROVIDER=gemini
AI_VISION_MODEL=gemini-1.5-flash

AI_STT_PROVIDER=web_speech_api
AI_STT_API_KEY=

AI_TTS_PROVIDER=web_speech_synthesis
AI_TTS_API_KEY=

# -----------------
# REGIONAL & LOCALIZATION DEFAULTS
# -----------------
DEFAULT_CURRENCY=COP
DEFAULT_TIMEZONE=America/Bogota
DEFAULT_LOCALE=es-CO
